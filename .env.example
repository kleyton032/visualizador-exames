# ====== Postgres (container db) ======
POSTGRES_USER=ver
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=ver

# ====== Autenticação (JWT / Sessão) ======
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-chars-hex
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_TTL_DAYS=1
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
CORS_ORIGIN=http://localhost:8080

# ====== Oracle legado ======
ORACLE_USER=troque-por-usuario
ORACLE_PASSWORD=troque
ORACLE_CONNECTION=ip-do-servidor:1521/service_name
ORACLE_THICK_MODE=true

# ====== Anexos ======
ANEXOS_BASE_DIR=/data/anexos

# ====== AWS S3 (anexos) — para STORAGE_DRIVER=s3 ======
STORAGE_DRIVER=local
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PRESIGN_TTL=60

# ====== Compressão de anexos ======
COMPRESSION_ENABLED=true
COMPRESSION_MIN_BYTES=500000
IMAGE_QUALITY=80
PDF_SETTINGS=/ebook

# ====== Porta do frontend ======
WEB_PORT=8080
