# ====== Postgres (container db) ======
POSTGRES_USER=ver
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=ver

# ====== Autenticação (JWT / Sessão) ======
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-chars-hex
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_TTL_DAYS=1
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
CORS_ORIGIN=http://localhost:8080

# ====== Oracle legado ======
ORACLE_USER=troque-por-usuario
ORACLE_PASSWORD=troque
ORACLE_CONNECTION=ip-do-servidor:1521/service_name

# ====== Anexos ======
ANEXOS_BASE_DIR=/data/anexos

# ====== Porta do frontend ======
WEB_PORT=8080
